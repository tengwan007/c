#include<iostream>
using namespace std;
int n,k;
int h[1000000],w[1000000];
bool check(int x){
	int count=0;
	for(int i=0;i<n;i++){
		count+=(h[i]/x)*(w[i]/x);
	}
	return count>=k;
}
int main(){
	cin>>n>>k;
	for(int i=0;i<n;i++){
		cin>>h[i]>>w[i];
	}
	int l=1,r=1000000;
	while(l<r){
		int mid=(l+r)>>1;
		if(check(mid)) l=mid;
		else r=mid-1;
	}
	cout<<l<<endl;
	return 0;
}
