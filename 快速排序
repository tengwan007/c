#include<iostream>
using namespace std;
int a[1000001];
int n;
void quicksort(int l, int r){
    if(l>=r)return;
    int i=l,j=r;
    int mid=(l+r)/2;
    int p=a[mid];
    while(i<=j){
        while(a[i]<p)i++;
        while(a[j]>p)j--;
        if(i<=j){
            swap(a[i],a[j]);
            i++;
            j--;
        }
    }
    if(l<j)quicksort(l,j);
    if(i<r)quicksort(i,r);
}
int main(){
    cin>>n;
    for(int i=0;i<n;i++)cin>>a[i];
    quicksort(0,n-1);
    for(int i=0;i<n;i++)cout<<a[i]<<" ";
    return 0;
}
